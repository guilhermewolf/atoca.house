---
# Node-specific configuration for node-01 (192.168.40.11)

machine:
  type: controlplane
  # Install configuration - node-01 specific disk
  install:
    diskSelector:
      model: SSD 256GB
  nodeLabels:
    topology.kubernetes.io/zone: node-01
---
apiVersion: v1alpha1
kind: HostnameConfig
hostname: node-01
---
apiVersion: v1alpha1
kind: LinkAliasConfig
name: enp5s0f3u2
selector:
  match: link.driver == "r8152"
---
apiVersion: v1alpha1
kind: LinkAliasConfig
name: enp2s0
selector:
  match: link.driver == "r8169"
---
apiVersion: v1alpha1
kind: BondConfig
name: bond0
links:
  - enp5s0f3u2
  - enp2s0
bondMode: active-backup
# Jumbo frames for NFS to nas.internal (192.168.40.160). VLAN 2 peers all
# support >= 9216. bond0.5 / bond0.6 stay at 1500 - IoT and VPN peers do not.
# Cilium pod MTU is pinned to 1500 in infra/k8s/networking/cilium/values.yaml.
mtu: 9000
---
apiVersion: v1alpha1
kind: DHCPv4Config
name: bond0
clientIdentifier: mac
---
apiVersion: v1alpha1
kind: VLANConfig
name: bond0.5
vlanID: 5
parent: bond0
mtu: 1500
---
apiVersion: v1alpha1
kind: VLANConfig
name: bond0.6
vlanID: 6
parent: bond0
mtu: 1500
