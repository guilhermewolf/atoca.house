---
# Node-specific configuration for node-01 (192.168.40.11)

machine:
  type: controlplane
  # Install configuration - system disk is the M.2 2242 slot
  install:
    diskSelector:
      busPath: /pci0000:00/0000:00:02.4/0000:04:00.0/nvme
  nodeLabels:
    topology.kubernetes.io/zone: node-01
---
apiVersion: v1alpha1
kind: HostnameConfig
hostname: node-01
---
apiVersion: v1alpha1
kind: LinkAliasConfig
name: enp5s0f3u2
selector:
  match: link.driver == "r8152"
---
apiVersion: v1alpha1
kind: LinkAliasConfig
name: enp2s0
selector:
  match: link.driver == "r8169"
---
apiVersion: v1alpha1
kind: BondConfig
name: bond0
links:
  - enp5s0f3u2
  - enp2s0
bondMode: active-backup
# Jumbo frames for NFS to nas.internal (192.168.40.160). VLAN 2 peers all
# support >= 9216. bond0.5 / bond0.6 stay at 1500 - IoT and VPN peers do not.
# Cilium pod MTU is pinned to 1500 in infra/k8s/networking/cilium/values.yaml.
mtu: 1500
---
apiVersion: v1alpha1
kind: DHCPv4Config
name: bond0
clientIdentifier: mac
---
apiVersion: v1alpha1
kind: VLANConfig
name: bond0.5
vlanID: 5
parent: bond0
mtu: 1500
---
apiVersion: v1alpha1
kind: VLANConfig
name: bond0.6
vlanID: 6
parent: bond0
mtu: 1500
---
# BIOS has no CPPC (_CPC), so amd-pstate can't load and acpi-cpufreq has no EPP.
# Capping boost keeps the 4800H under ~90 C (it was hitting 100 C). If CPPC gets
# enabled in BIOS, replace this with energy_performance_preference: balance_power
# per CPU (cpu0..cpu15) and drop the boost cap.
apiVersion: v1alpha1
kind: SysfsConfig
params:
  devices.system.cpu.cpufreq.boost: "0"
