
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  extends: [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigests",
    "github>guilhermewolf/atoca.house//.renovate/autoMerge.json5",
    "github>guilhermewolf/atoca.house//.renovate/changelogs.json5",
    "github>guilhermewolf/atoca.house//.renovate/customManagers.json5",
    "github>guilhermewolf/atoca.house//.renovate/grafanaDashboards.json5",
    "github>guilhermewolf/atoca.house//.renovate/groups.json5",
    "github>guilhermewolf/atoca.house//.renovate/overrides.json5",
    ":automergeBranch",
    ":disableRateLimiting",
    ":dependencyDashboard",
    ":semanticCommits",
    ":timezone(Europe/Amsterdam)",
  ],

  dependencyDashboardTitle: "Renovate Dashboard 🤖",

  suppressNotifications: [
    "prEditedNotification",
    "prIgnoreNotification",
  ],

  ignorePaths: [
    "**/resources/**",
  ],

  // Exclude internal and unavailable container registries
  packageRules: [
    {
      description: "Ignore all internal Forgejo container images",
      matchDatasources: ["docker"],
      matchPackageNames: ["/^forge\\.atoca\\.house\\//"],
      enabled: false,
    },
    {
      description: "Ignore Crunchy Data PGO registry SSL failure",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "registry.developers.crunchydata.com/crunchydata/pgo",
      ],
      enabled: false,
    },
  ],

  // Prevent access to the internal Forgejo registry
  hostRules: [
    {
      matchHost: "https://forge.atoca.house",
      enabled: false,
    },
  ],

  kubernetes: {
    managerFilePatterns: [
      "/\\.yaml(?:\\.j2)?$/",
    ],
  },

  "docker-compose": {
    managerFilePatterns: [
      "/(^|/)stacks/.+\\.ya?ml$/",
    ],
  },

  "helm-values": {
    managerFilePatterns: [
      "/(^|/)infra/k8s/.+/values\\.ya?ml$/",
      "/(^|/)apps/.+/values\\.ya?ml$/",
    ],
  },
}
